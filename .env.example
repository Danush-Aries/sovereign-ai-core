# Sovereign AI Core — Environment Configuration
# Copy this file to .env and edit before running.

# ── API Security ──────────────────────────────────────────────────────────────
# A random secret used to authenticate requests to the gateway.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SOVEREIGN_API_KEY=change-me-to-a-random-secret

# ── Local LLM Backend ─────────────────────────────────────────────────────────
# URL of your running Ollama or vLLM instance (loopback-only by design).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model names — must be pulled in Ollama first, e.g.: ollama pull llama3
LITE_MODEL=phi3
STANDARD_MODEL=llama3
FRONTIER_MODEL=mixtral

# ── Storage Paths ─────────────────────────────────────────────────────────────
# All data is stored locally under this directory.
# Leave blank to default to <project-root>/.sovereign/
SOVEREIGN_DATA_DIR=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
